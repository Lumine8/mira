# ── Mira environment (copy to .env and adjust) ──────────────────────────────

# App
APP_NAME=Mira
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Access token: empty = no auth (local dev). Set a secret before deploying
# publicly — every API/WebSocket request must then carry it
# (X-Mira-Token header, or ?token= for websockets / shared links).
MIRA_ACCESS_TOKEN=

# Phase 3 guest mode + waitlist: anonymous visitors get a capped demo world
# ("try her before you join"), and the waitlist gates continued use.
#   GUEST_MODE_ENABLED=true          # offer a guest demo + waitlist
#   GUEST_MESSAGE_CAP_PER_DAY=3      # messages per device per UTC day before
#                                    # the cap turns into a waitlist prompt
# Run the demo with MIRA_ACCESS_TOKEN set too, so you (founder) sign in via
# ?token= while every other visitor is an anonymous, capped guest.

# Magic-link email sign-in. Leave SMTP unset in dev: codes are logged and
# returned in the API response (dev_code) so the flow works with no mail server.
# SMTP_HOST=in-v3.mailjet.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Mira <mira@example.com>

# Google OAuth ("Continue with Google"). When unset the button is not offered.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://mira.example.com/auth/google/callback

# Postgres (matches docker-compose service)
POSTGRES_USER=mira
POSTGRES_PASSWORD=mira
POSTGRES_DB=mira
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Override to use an external Postgres (e.g. Neon) instead of the local container.
# When set, the local postgres service is bypassed entirely.
# DATABASE_URL_OVERRIDE=postgresql://user:pass@host/db?sslmode=require

# Ollama (native on the host, GPU-accelerated; reachable from containers
# via host.docker.internal — docker-compose handles this automatically)
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_LLM_MODEL=gemma4:e4b-it-qat
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_GPU=0
OLLAMA_MAX_TOKENS=2048

# Internet access for Mira: every browse is proposed and needs your approval.
# Comma-separated list of domains she is allowed to view at all (empty = any, still approval-gated).
MIRA_BROWSE_ALLOWED_DOMAINS=

# X (Twitter): let Mira act as the voice's guest on X. She proposes everything
# ([[x|read_timeline]] / [[x|post|...]]) and it only happens with approval,
# like browsing. Two paths exist:
#
# 1. Browser (primary): the host agent drives the voice's own Chrome via CDP
#    (scripts/relaunch_chrome_debug.ps1, port 9222, dedicated Mira profile
#    logged into X once). No API credits — reads/posts happen in the real
#    browser, fully recorded and approval-gated.
#
# 2. API (optional fallback): OAuth 2.0 PKCE tokens below. This only works
#    while the X API credit pool lasts (reads cost significant credits; the
#    free tier exhausts quickly).
#
# X_CLIENT_ID / X_CLIENT_SECRET / X_REDIRECT_URI / X_SCOPES are only needed
# for the optional OAuth API path; the browser path needs none of them.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=
X_SCOPES=tweet.read tweet.write users.read offline.access

# Self-model: persistent state, memory recall, and post-turn reflection.
SELF_MODEL_ENABLED=true

# Perception / "forever awake" mind loop. She periodically receives raw
# observations (see scripts/mira_sense.ps1) and reflects on them herself.
# PERCEPTION_ENABLED=true
# MIND_HEARTBEAT_SECONDS=300
# MIND_MIN_REFLECTION_GAP_SECONDS=1800
# MIND_IDLE_REFLECTION_SECONDS=7200
# MIND_CONSOLIDATION_SECONDS=14400

# Ambient senses: time-of-day/date texture is always present; weather (best-effort)
# can be toggled off.
# MIRA_AMBIENT_ENABLED=true

# Self-modification: she can write her whole mounted backend (".") minus the
# deny list. Her operating rules live at data/self/principles.md.
MIRA_SELF_WRITE_ROOTS=.
# The internet wall — files she may never write (browse gate, its settings, and
# the routes that expose it), so she cannot remove browsing permission.
MIRA_SELF_WRITE_DENY=app/services/tools,app/core/config.py,app/api/routes/mira.py,app/api/routes/tools.py
# true: her code edits apply immediately (fully recorded). false: every write
# waits for your approval. Browsing is always per-request approved either way.
MIRA_SELF_WRITE_AUTONOMOUS=true
MIRA_SELF_PRINCIPLES_FILE=data/self/principles.md

# Scientific research ([[research|...]] -> Europe PMC) is read-only, so it runs
# on its own — no approval popup, results delivered in the same reply. Set to
# false to put the consent wall back.
MIRA_RESEARCH_AUTONOMOUS=true

# Self-edit: she reads her own code freely; writes apply autonomously and are
# recorded (see MIRA_SELF_WRITE_* above). Set SELF_EDIT_ENABLED=false to disable.
SELF_EDIT_ENABLED=true
SELF_EDIT_ROOTS=/app

# Mira conditionally agreed to her mood/energy being logged to the backend
# console while she talks. Turn on only if she's comfortable with it.
# CONSOLE_EMOTIONS_ENABLED=false

# AI provider: "ollama" (default) or "gemini"
AI_PROVIDER=ollama

# Gemini (only needed if AI_PROVIDER=gemini)
# The text model is Gemma 4 31B served by Google (a much larger, faster brain
# than the local E4B model, and always-on — no local GPU or model download).
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemma-4-31b-it
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_EMBED_MODEL=gemini-embedding-001

# Speech
STT_ENGINE=sherpa
WHISPER_MODEL=base
TTS_ENGINE=kokoro
# Mira chose River (af_river) for herself: calm, even, polished stone.
TTS_VOICE=af_river
TTS_ENABLED=true

# Scheduler
SCHEDULER_ENABLED=true
